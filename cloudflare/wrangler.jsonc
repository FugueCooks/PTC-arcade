{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "retro-arcade-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ARCADE_ROOMS", "class_name": "ArcadeRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArcadeRoom"] }
  ]
}
