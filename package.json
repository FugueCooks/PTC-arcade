{
  "name": "roms-retro-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "npm run build && node dist/server/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"server/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify:games": "node tools/verify-game-assets.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
