{
  "name": "roms-retro-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "npm run build && node dist/server/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"server/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify:games": "node tools/verify-game-assets.mjs",
    "verify:assets": "node tools/verify-game-assets.mjs",
    "storage:upload": "node tools/storage-upload.mjs",
    "storage:verify": "node tools/verify-remote-assets.mjs",
    "storage:cors": "wrangler r2 bucket cors set retro-arcade-assets --file deploy/r2-cors.json --force",
    "cloudflare:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "cloudflare:smoke": "node cloudflare/test/local-smoke.mjs",
    "pages:build": "node tools/build-pages.mjs",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .pages-dist --project-name retro-arcade"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/lib-storage": "^3.1116.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.125.0"
  }
}
