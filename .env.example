PORT=8080
NODE_ENV=production
TRUST_PROXY=1

# Phase 8 durable identity storage. Keep DATABASE_URL secret and use a TLS-enabled
# PostgreSQL connection string in production. The server remains guest-only when
# DATABASE_URL is blank unless DATABASE_REQUIRED=1.
DATABASE_URL=
DATABASE_REQUIRED=0
DATABASE_STARTUP_TIMEOUT_SECONDS=5
DATABASE_POOL_MAX=10
SESSION_TTL_DAYS=30
GUEST_SESSION_TTL_DAYS=30
PASSWORD_ARGON2_MEMORY_KIB=19456
PASSWORD_ARGON2_ITERATIONS=2
PASSWORD_ARGON2_PARALLELISM=1
AUTH_COOKIE_NAME=arcade_session
# Production deployments must use secure HTTPS cookies. Local HTTP development may use 0.
AUTH_COOKIE_SECURE=1
AUTH_REQUEST_LIMIT_PER_10_MINUTES=30
# Exact browser origin permitted to mutate account state in production.
PUBLIC_APP_ORIGIN=
# Local development only. Never enable in production.
AUTH_DEVELOPMENT_TOKENS=0
SERVER_ID=
SERVER_REGION=local
SOFTWARE_VERSION=development

# Conservative safety defaults until Phase 7 load tests establish measured limits.
MAX_PLAYERS_PER_ROOM=25
MIN_AVAILABLE_ROOMS=1
ROOM_IDLE_TIMEOUT_SECONDS=900
MAX_ROOMS_PER_SERVER=10
MAX_PLAYERS_PER_SERVER=250
MAX_PENDING_CONNECTIONS=128
RECONNECT_GRACE_SECONDS=10
MAX_SERVER_MEMORY_MB=768
MAX_EVENT_LOOP_DELAY_MS=150
SERVER_DRAIN_TIMEOUT_SECONDS=45
SERVER_SHUTDOWN_WARNING_SECONDS=15

# Shared coordination. Leave REDIS_URL blank for the single-process local fallback.
REDIS_URL=
REDIS_REQUIRED=0
REDIS_STARTUP_TIMEOUT_SECONDS=5
PUBLIC_REALTIME_URL=
MATCHMAKING_URL=
ADMISSION_RESERVATION_TTL_SECONDS=15
# PUBLIC_REALTIME_URL must be browser-routable. MATCHMAKING_URL may point to
# a separate placement service; leave it blank to use the page's own origin.
REDIS_KEY_PREFIX=arcade:v1:production
SERVER_HEARTBEAT_SECONDS=10
SERVER_TTL_SECONDS=35
ROOM_DIRECTORY_TTL_SECONDS=45
ROOM_OWNERSHIP_TTL_SECONDS=30

# Public CDN/object-storage game directory containing every game listed in
# deploy/public-assets.manifest.json. Leave blank for local assets/games fallback.
GAME_ASSET_BASE_URL=

# Exact public/CDN URL for the legally distributable PlayStation BIOS used by
# hosted PS1 cabinets. Leave blank for assets/bios/SCPH1001.BIN local fallback.
BIOS_ASSET_URL=

# S3-compatible object storage used only by the upload/verification tools.
# Cloudflare R2 uses region "auto" and an endpoint ending in .r2.cloudflarestorage.com.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PREFIX=arcade

CABINET_INTERACTION_DISTANCE=2.6
CABINET_ACTIVATION_TIMEOUT_MS=5000
CABINET_REQUEST_COOLDOWN_MS=250
PRESENCE_NEARBY_DISTANCE=12
PRESENCE_SOCIAL_DISTANCE=15
PRESENCE_FAR_UPDATE_INTERVAL_MS=300
AFK_TIMEOUT_MS=120000
CHAT_MAX_LENGTH=180
REACTION_COOLDOWN_MS=550
WORLD_REQUEST_COOLDOWN_MS=500
WORLD_EVENT_INTERVAL_MS=90000
